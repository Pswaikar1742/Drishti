# Project Drishti - Environment Configuration
# Copy this file to .env and add your actual API key

# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Database Configuration (Prototype)
DATABASE_URL=sqlite:///./drishti.db

# Database Configuration (Production - Uncomment when deploying)
# DATABASE_URL=postgresql://username:password@localhost:5432/drishti_db

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Streamlit Configuration
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
